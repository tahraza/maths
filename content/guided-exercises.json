    {
      "id": "ln-derivee",
      "title": "Dérivée avec logarithme",
      "theme": "Dérivation",
      "difficulty": "moyen",
      "duration": 12,
      "description": "Calculer la dérivée d'une fonction avec logarithme.",
      "problem": "Soit $f(x) = x\\ln(x) - x$. Calculer $f'(x)$.",
      "steps": [
        { "instruction": "Identifie les termes à dériver.", "hint": "On a un produit $x\\ln(x)$ et un terme simple $-x$.", "solution": "$f(x) = x\\ln(x) - x$" },
        { "instruction": "Dérive $x\\ln(x)$ en utilisant la formule $(uv)' = u'v + uv'$.", "hint": "$u = x$, $v = \\ln(x)$", "solution": "$(x\\ln(x))' = 1 \\times \\ln(x) + x \\times \\frac{1}{x} = \\ln(x) + 1$" },
        { "instruction": "Dérive $-x$.", "hint": "La dérivée de $x$ est 1.", "solution": "$(-x)' = -1$" },
        { "instruction": "Combine les résultats.", "hint": "Additionne les deux dérivées.", "solution": "$f'(x) = \\ln(x) + 1 - 1 = \\ln(x)$" }
      ],
      "finalAnswer": "$f'(x) = \\ln(x)$"
    },
    {
      "id": "equation-degre2",
      "title": "Équation du second degré",
      "theme": "Algèbre",
      "difficulty": "facile",
      "duration": 10,
      "description": "Résoudre une équation du second degré.",
      "problem": "Résoudre $2x^2 - 7x + 3 = 0$.",
      "steps": [
        { "instruction": "Identifie les coefficients $a$, $b$, $c$.", "hint": "$ax^2 + bx + c = 0$", "solution": "$a = 2$, $b = -7$, $c = 3$" },
        { "instruction": "Calcule le discriminant $\\Delta = b^2 - 4ac$.", "hint": "Attention aux signes.", "solution": "$\\Delta = (-7)^2 - 4(2)(3) = 49 - 24 = 25$" },
        { "instruction": "Analyse le signe de $\\Delta$.", "hint": "$\\Delta > 0$ signifie 2 solutions.", "solution": "$\\Delta = 25 > 0$ donc deux solutions réelles distinctes." },
        { "instruction": "Calcule les solutions avec $x = \\frac{-b \\pm \\sqrt{\\Delta}}{2a}$.", "hint": "$\\sqrt{25} = 5$", "solution": "$x_1 = \\frac{7 + 5}{4} = 3$ et $x_2 = \\frac{7 - 5}{4} = \\frac{1}{2}$" }
      ],
      "finalAnswer": "$S = \\{\\frac{1}{2}, 3\\}$"
    },
    {
