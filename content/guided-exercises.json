        { "instruction": "Résous l'équation du second degré en $X$.", "hint": "Calcule le discriminant ou factorise.", "solution": "$(X - 2)(X - 3) = 0$, donc $X = 2$ ou $X = 3$" },
        { "instruction": "Reviens à $x$ avec $X = e^x$.", "hint": "Si $e^x = k$, alors $x = \\ln(k)$.", "solution": "$e^x = 2 \\Rightarrow x = \\ln 2$ et $e^x = 3 \\Rightarrow x = \\ln 3$" },
        { "instruction": "Vérifie que les solutions sont valides.", "hint": "$e^x > 0$ toujours, donc pas de solution à rejeter.", "solution": "Les deux solutions sont acceptables." }
